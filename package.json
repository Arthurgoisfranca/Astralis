{
  "name": "astralis",
  "version": "1.4.0",
  "private": true,
  "description": "Gestão de campanhas e lobby de RPG em tempo real",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "node server.js",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "migrate:cloud": "node --env-file=.env scripts/migrateSupabaseData.js",
    "test": "node --test --test-timeout=60000 \"tests/*.test.cjs\" \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
